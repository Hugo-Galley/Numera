# --- SUIVI BUDGET CONFIGURATION ---

# Database
# Use absolute path for Docker: sqlite:////app/data/suivi_budget.db
DATABASE_URL=sqlite:///./backend/data/suivi_budget.db

# Security
# Generate a secret key: openssl rand -hex 32
SECRET_KEY=generate-a-long-random-key-here

# Admin Access
ADMIN_USERNAME=admin
# Generate hash: python3 scripts/change_password.py your-password
# Keep the hash between single quotes, otherwise Docker Compose treats each $ as a variable
ADMIN_PASSWORD_HASH=generate-using-scripts-change-password

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:8082

# Instance de démonstration (make demo) : clé distincte de SECRET_KEY (openssl rand -hex 32)
DEMO_SECRET_KEY=
# DEMO_CORS_ORIGINS=https://demo-budget.galleyhugo.com

# Backup settings
# BACKUP_KEY is a Fernet key: openssl rand -base64 32 | tr '+/' '-_'
BACKUP_KEY=generate-a-fernet-key-using-python
BACKUP_INTERVAL_SECONDS=86400
# Envoi des sauvegardes chiffrées vers un dépôt GitHub PRIVÉ dédié (laisser vide = désactivé)
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_TOKEN=
# Jours conservés sur GitHub (une sauvegarde par jour)
GITHUB_BACKUP_KEEP_DAYS=30
RETENTION_DAYS=7
