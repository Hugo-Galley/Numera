# --- Serveur MCP — Numera ---
# Nom du serveur MCP (affiché dans les clients)
MCP_SERVER_NAME=Numera

# Transport : stdio | streamable-http | sse
MCP_TRANSPORT=stdio

# Host et port (uniquement pour streamable-http et sse)
MCP_HOST=127.0.0.1
MCP_PORT=8100

# --- API ---
# Direct backend : http://backend:8001 (Docker) ; via Nginx : https://domaine/api
MCP_API_URL=http://backend:8001
# stdio uniquement : token généré dans Numera (Paramètres → Sécurité). En HTTP, chaque client envoie le sien.
MCP_API_TOKEN=
