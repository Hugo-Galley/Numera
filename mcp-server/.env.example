# --- Serveur MCP — Numera ---
# Mode : api | sqlite (auto-détecté si absent : MCP_API_URL → api, fichier MCP_DB_PATH présent → sqlite)
# MCP_MODE=api

# Nom du serveur MCP (affiché dans les clients)
MCP_SERVER_NAME=Numera

# Transport : stdio | streamable-http | sse (le mode SQLite n'accepte que stdio)
MCP_TRANSPORT=stdio

# Host et port (uniquement pour streamable-http et sse)
MCP_HOST=127.0.0.1
MCP_PORT=8100

# --- Mode API proxy ---
# Direct backend : http://backend:8001 (Docker) ; via Nginx : https://domaine/api
MCP_API_URL=http://backend:8001
# stdio uniquement : token généré dans Numera (Paramètres → Compte). En HTTP, chaque client envoie le sien.
MCP_API_TOKEN=

# --- Mode SQLite direct (local, stdio) ---
MCP_DB_PATH=/data/suivi_budget.db
