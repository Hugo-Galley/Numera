# --- Serveur MCP — Numera ---
# Mode : api | sqlite (auto-détecté si absent : MCP_API_URL → api, fichier MCP_DB_PATH présent → sqlite)
# MCP_MODE=api

# Nom du serveur MCP (affiché dans les clients)
MCP_SERVER_NAME=Suivi Budget MCP

# Transport : stdio | streamable-http | sse
MCP_TRANSPORT=stdio

# Host et port (uniquement pour streamable-http et sse)
MCP_HOST=127.0.0.1
MCP_PORT=8100
# Obligatoire pour streamable-http et sse (token bearer, 16+ caractères) : openssl rand -hex 32
MCP_AUTH_TOKEN=

# --- Mode SQLite direct ---
MCP_DB_PATH=/data/suivi_budget.db

# --- Mode API proxy ---
# Derrière le Nginx de prod, terminer par /api (ex. https://domaine/api) ; direct backend : http://backend:8001
MCP_API_URL=http://backend:8001
MCP_API_USERNAME=admin
# Obligatoire en mode API
MCP_API_PASSWORD=
